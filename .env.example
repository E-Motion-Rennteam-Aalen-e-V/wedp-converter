# --- Admin login (/admin) ---

# Required. Signs the HMAC session cookie — must be at least 16 characters.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Break-glass admin (tier 1). Always works, independent of the other two
# sources. Generate the hash with: node scripts/hash-password.mjs "your-password"
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Local users (tier 2) are stored in .admin-users.json at the project root
# (git-ignored, not committed). No env vars needed — see README.

# Optional remote credentials repo (tier 3). Leave unset to disable it
# entirely; only consulted when a username matches neither tier above.
CREDENTIALS_REPO_URL=
CREDENTIALS_REPO_TOKEN=
CREDENTIALS_REPO_BRANCH=main
CREDENTIALS_REPO_PATH=credentials.json
